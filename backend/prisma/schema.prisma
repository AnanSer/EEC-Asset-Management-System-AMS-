// EEC EAMS – Prisma Schema (Phase 1)
// Database models will be added in Phase 2.
// Currently configured for PostgreSQL connection only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

