// EEC EAMS – Ethiopian Engineering Corporation Enterprise Asset Management System
// Prisma Schema – Phase 2: Database Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  PRINTER
  SCANNER
  ROUTER
  SWITCH
  PROJECTOR
  MONITOR
  SERVER
  UPS
  OTHER
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  TESTING
  RETIRED
  DISPOSED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_REPAIR
  DAMAGED
  RETIRED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionStatus {
  PENDING
  PASSED
  FAILED
  NEEDS_REPAIR
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  description      String?
  location         String?
  officeLocation   String?
  building         String?
  floor            String?
  headOfDepartment String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  employees        EmployeeProfile[]
  assets           Asset[]

  @@index([code])
  @@index([isActive])
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  role                    UserRole                 @default(EMPLOYEE)
  status                  AccountStatus            @default(ACTIVE)
  isEmailVerified         Boolean                  @default(false)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  employeeProfile         EmployeeProfile?
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model EmployeeProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId       String            @unique
  firstName        String
  lastName         String
  phone            String?
  jobTitle         String
  departmentId     String
  department       Department        @relation(fields: [departmentId], references: [id])
  officeLocation   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  assetAssignments AssetAssignment[]

  @@index([employeeId])
  @@index([departmentId])
}

model Asset {
  id                 String              @id @default(uuid())
  assetCode          String              @unique
  name               String
  category           AssetCategory
  brand              String?
  model              String?
  serialNumber       String              @unique
  status             AssetStatus         @default(AVAILABLE)
  condition          AssetCondition      @default(GOOD)
  departmentId       String?
  department         Department?         @relation(fields: [departmentId], references: [id])
  location           String?
  purchaseDate       DateTime?
  purchasePrice      Decimal?            @db.Decimal(12, 2)
  warrantyExpiry     DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  assignments        AssetAssignment[]
  maintenanceTickets MaintenanceTicket[]

  @@index([assetCode])
  @@index([serialNumber])
  @@index([status])
  @@index([condition])
  @@index([category])
  @@index([departmentId])
}

model AssetAssignment {
  id                String          @id @default(uuid())
  assetId           String
  asset             Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          EmployeeProfile @relation(fields: [employeeId], references: [id])
  assignedDate      DateTime        @default(now())
  returnedDate      DateTime?
  conditionOnAssign String?
  conditionOnReturn String?
  isCurrent         Boolean         @default(true)
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([assetId])
  @@index([employeeId])
  @@index([isCurrent])
}

model MaintenanceTicket {
  id                 String              @id @default(uuid())
  ticketNumber       String              @unique
  assetId            String
  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  title              String
  description        String
  priority           MaintenancePriority @default(MEDIUM)
  status             MaintenanceStatus   @default(OPEN)
  cost               Decimal?            @db.Decimal(10, 2)
  startDate          DateTime?
  completedDate      DateTime?
  reportedBy         String?
  assignedTechnician String?
  resolutionNotes    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  inspectionTests    InspectionTest[]

  @@index([ticketNumber])
  @@index([assetId])
  @@index([status])
  @@index([priority])
}

model InspectionTest {
  id              String            @id @default(uuid())
  ticketId        String
  ticket          MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  testType        String
  status          InspectionStatus  @default(PENDING)
  testedBy        String
  testDate        DateTime          @default(now())
  findings        String?
  recommendations String?
  passed          Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([ticketId])
  @@index([status])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
